{
  "type": "minecraft:sequence",
  "sequence": [
    {
      "type": "minecraft:condition",
      "if_true": "minecraft:on_floor",
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "noise": "sift:blobs",
              "min_threshold": 0.28,
              "max_threshold": 1000000.0
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "sift:light_sculk_grass_block"
            }
          },
          {
            "type": "minecraft:block",
            "result_state": "sift:sculk_grass_block"
          }
        ]
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:stone_depth",
        "surface_type": "floor",
        "add_surface_depth": true,
        "secondary_depth_range": 0,
        "offset": 3
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "sift:sculk_grass_block"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": "minecraft:on_ceiling",
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:gray_concrete"
      }
    },
    {
      "type": "minecraft:block",
      "result_state": "minecraft:gray_concrete"
    }
  ]
}
